# Copy to .env.local and fill in. .env.local is gitignored.
#
# WARNING: Vite inlines every VITE_* variable into the client bundle. Anything
# here is readable by anyone who opens devtools on the deployed site. Keeping
# values out of git is all this buys — it is not access control.
#
# Real protection needs a backend that verifies credentials server-side and
# issues a session. See supabase/schema.sql for the intended replacement.

# Supabase. The publishable key is public BY DESIGN — Row Level Security in
# Postgres decides what it can actually read or write.
# NEVER put an sb_secret_... key in this file. It bypasses RLS entirely and
# belongs only in server-side environment variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Optional, DEV ONLY. Show the sign-in code on screen instead of emailing it,
# for working without a mail provider. Production builds ignore it.
# Leave unset once custom SMTP is configured, so local runs and the deployed
# site take the same path.
# VITE_DEV_LOCAL_OTP=true

# Demo admin login. Only a SHA-256 hash is stored, so the password itself
# never reaches the bundle. Generate one with:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD_SHA256=
