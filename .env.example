# Copy to .env.local and fill in. .env.local is gitignored.
#
# WARNING: Vite inlines VITE_* variables into the client bundle. Whatever you
# put here is readable by anyone who opens devtools on the deployed site.
# It keeps credentials out of git history — nothing more. Real access control
# needs a backend that checks the password server-side.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=change-me
